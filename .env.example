# Copy to .env and fill in. .env is gitignored.

# --- Claude (chat + vision) ---
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Supabase (database + file storage) ---
# Project Settings -> API. Use the SERVICE ROLE key (RLS is disabled in schema.sql).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Model routing (optional) ---
# These names are mapped to Claude models by providers/model_map.py.
# "mini"/"fast" -> Haiku (cheap), everything else -> Sonnet (smart).
MODEL_DEFAULT=claude-haiku-4-5-20251001
MODEL_COMPLEX=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=4096

# --- Local embeddings (optional) ---
# Runs on-device via sentence-transformers; no API key. 1024-dim.
# If you change this, the dimension must match vector(1024) in schema.sql.
LOCAL_EMBED_MODEL=BAAI/bge-large-en-v1.5

# Publishable (anon) key — Project Settings -> API. Used by the backend to verify user JWTs.
SUPABASE_ANON_KEY=sb_publishable_...

# --- Production hardening / cost controls (optional; sensible defaults) ---
# CORS allowlist. Default "*" (dev/preview). In prod set to your Vercel origin(s),
# comma-separated, e.g. https://vindexa.app,https://www.vindexa.app
ALLOWED_ORIGINS=*

# Anthropic prompt caching (cuts cost on long reused system prompts). 1=on.
PROMPT_CACHE_ENABLED=1

# Per-user AI request cap (sliding 60s window) — protects free-trial spend.
AI_RATE_LIMIT_PER_MINUTE=20

# Cost-estimate overrides (USD per 1M tokens) for /admin/usage. Defaults are
# estimates — confirm against the current Anthropic price sheet.
# PRICE_HAIKU_IN=1.00
# PRICE_HAIKU_OUT=5.00
# PRICE_SONNET_IN=3.00
# PRICE_SONNET_OUT=15.00
